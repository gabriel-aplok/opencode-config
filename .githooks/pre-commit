#!/bin/sh
# Format the staged files with Prettier before the commit.
# Enable with: git config core.hooksPath .githooks

files=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(html|css|js|mjs|cjs|json|jsonc|md)$' || true)

if [ -z "$files" ]; then
  exit 0
fi

npx --yes prettier@3 --write $files >/dev/null 2>&1 || exit 0

git add $files
exit 0
